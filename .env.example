# ============================================================
# FALCON AGENCY — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# === WHATSAPP (Meta Business API) ===
# Get from: business.facebook.com → WhatsApp → API setup
WHATSAPP_PHONE_ID=your_whatsapp_phone_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_RECIPIENT=91XXXXXXXXXX
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose

# === AI MODEL KEYS ===
# Anthropic Claude — console.anthropic.com (add $5 credit)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA NIM — integrate.api.nvidia.com
NVIDIA_API_KEY=your_nvidia_key_here
# OpenRouter (optional backup) — openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here
# Gemini (optional) — aistudio.google.com
GEMINI_API_KEY=your_gemini_key_here
# OpenAI (optional) — platform.openai.com
OPENAI_API_KEY=your_openai_key_here

# === ELEVENLABS (voice — optional) ===
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# === SERPER.DEV (Google search — AEO agent needs this!) ===
# Free tier: 2500 searches/month — serper.dev
SERPER_API_KEY=your_serper_key_here

# === GOOGLE ANALYTICS 4 ===
# Property ID from GA4 Admin → Property Settings → Property ID
GA4_PROPERTY_ID=your_ga4_property_id_here
# Service account JSON path (recommended)
GA4_SERVICE_ACCOUNT_JSON=/path/to/ga4-service-account.json

# === GOOGLE SEARCH CONSOLE ===
# OPTION 1: Service Account (recommended)
# 1. Google Cloud Console → Enable Search Console API
# 2. IAM → Service Accounts → Create → Download JSON
# 3. Search Console → Settings → Users → Add service account email as Owner
GSC_SERVICE_ACCOUNT_JSON=/path/to/gsc-service-account.json
# OPTION 2: OAuth (alternative to service account)
# GSC_CLIENT_ID=your_client_id
# GSC_CLIENT_SECRET=your_client_secret
# GSC_REFRESH_TOKEN=your_refresh_token

# === CPANEL (falconherbs.com hosting) ===
CPANEL_USERNAME=your_cpanel_username
CPANEL_API_TOKEN=your_cpanel_api_token
CPANEL_DOMAIN=falconherbs.com
CPANEL_PORT=2083

# === WHM (server diagnostics + Apache restart) ===
WHM_URL=https://your-server-ip:2087
WHM_USER=root
WHM_PASSWORD=your_whm_password

# === SITE ALERTS (Director) ===
# MUTE_SITE_ALERTS=1          # Maintenance mode — no site-down WhatsApp alerts
# SITE_ALERT_COOLDOWN_MIN=30  # Minutes between repeat alerts (default 10)

# === WORDPRESS DATABASE ===
WP_DB_NAME=your_wordpress_database_name

# === FALCONHERBS (WooCommerce + WordPress) ===
FALCONHERBS_WC_API_KEY=ck_xxxxxxxxxxxx
FALCONHERBS_WC_API_SECRET=cs_xxxxxxxxxxxx
FALCONHERBS_WP_USER=falconherbs
# WP Application Password (Users > Profile > Application Passwords)
# IMPORTANT: Use quotes if password has spaces!
FALCONHERBS_WP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# === FTP (offsite backup storage — optional) ===
FTP_HOST=your_ftp_host
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
FTP_BACKUP_DIR=/backups/falcon/

# === DATABASE ===
DATABASE_URL=sqlite:///data/falcon.db

# === SECURITY ===
ENCRYPTION_KEY=generate_with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# === ENVIRONMENT ===
ENVIRONMENT=development
