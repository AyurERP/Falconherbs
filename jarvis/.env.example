# Server
PORT=3001
DB_PATH=data/jarvis.db

# LLM Configuration
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT=30000
NVIDIA_MAX_RETRIES=2

OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=60000
OLLAMA_MAX_RETRIES=1

DEFAULT_LLM_PROVIDER=nvidia
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
SYSTEM_PROMPT=You are JARVIS, a highly capable personal AI assistant. You are direct, efficient, and helpful.
